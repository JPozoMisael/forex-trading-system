# ==========================================
# CONFIGURACIÓN DEL SISTEMA DE TRADING FOREX
# ==========================================

# --- PROVEEDOR DE DATOS DE MERCADO ---
# mt5 (activo ahora, solo pruebas locales en Windows con el terminal MT5 abierto).
# "oanda" quedó comentado en build_market_client() hasta decidir un broker definitivo
# con API REST apto para el despliegue en Dokploy/Linux.
MARKET_DATA_PROVIDER=mt5

# --- BROKER OANDA (inactivo por ahora, se deja como referencia) ---
# Obtén tus credenciales en https://fxtrade.oanda.com o https://www.oanda.com/demo-account
OANDA_API_KEY=tu_api_key_aqui
OANDA_ACCOUNT_ID=tu_account_id_aqui
# Valores válidos: practice (Demo) | live (Real). No agregues comentarios en esta
# misma línea: Docker Compose no los recorta y quedan pegados al valor.
OANDA_ENVIRONMENT=practice

# --- PARES DE DIVISAS Y TEMPORALIDAD ---
# Pares a operar separados por coma (formato OANDA: EUR_USD, USD_JPY, GBP_USD, AUD_USD)
FOREX_PAIRS=EUR_USD,USD_JPY,GBP_USD,AUD_USD
# Granularidad de velas (M1, M5, M15, H1, H4, D)
CANDLE_GRANULARITY=M5
# Frecuencia de muestreo en segundos
COLLECTOR_POLL_SECONDS=30

# --- GESTIÓN DE RIESGO INSTITUCIONAL ---
# Porcentaje de riesgo de la cuenta por operación (ej: 1.0 = 1%)
RISK_PER_TRADE_PCT=1.0
# Número máximo de posiciones abiertas simultáneas
MAX_OPEN_POSITIONS=3
# Límite de pérdida diaria máxima (Circuit Breaker / Kill Switch en %)
MAX_DAILY_DRAWDOWN_PCT=5.0
# Spread máximo tolerable en pips para permitir entradas
MAX_SPREAD_PIPS=3.0
# Distancia por defecto a SL y TP en pips si la estrategia no los calcula dinámicamente
DEFAULT_STOP_LOSS_PIPS=20.0
DEFAULT_TAKE_PROFIT_PIPS=40.0
# Ratio mínimo beneficio/riesgo (TP_dist / SL_dist)
MIN_RISK_REWARD_RATIO=1.5

# --- MODO DE EJECUCIÓN ---
# Si es true, simula ejecuciones localmente sin interactuar con fondos de OANDA
DRY_RUN=false

# --- BASE DE DATOS (TimescaleDB / PostgreSQL) ---
POSTGRES_USER=forex
POSTGRES_PASSWORD=forex_pw
POSTGRES_DB=forex_data
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# --- MESSAGE BROKER (Redis Pub/Sub) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- MT5 (solo si MARKET_DATA_PROVIDER=mt5, para pruebas locales en Windows) ---
# No se usa en el despliegue de Dokploy/Linux: el paquete MetaTrader5 requiere
# el terminal de escritorio corriendo en la misma máquina. Usa aquí las
# credenciales de tu cuenta demo mientras no te decides por un broker.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=MetaQuotes-Demo
MT5_TIMEOUT=60000
DEFAULT_VOLUME=0.01
SLIPPAGE=10

# --- ALERTAS EN TIEMPO REAL (Telegram) ---
# Crea tu bot con @BotFather y obtén tu chat ID con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_TELEGRAM_SIGNALS=true
ENABLE_TELEGRAM_ORDERS=true
ENABLE_TELEGRAM_TRADES=true

# --- EMAIL (alertas de señales, órdenes y trades directo a tu correo) ---
# Con Gmail: activa verificación en 2 pasos y genera una "contraseña de
# aplicación" en myaccount.google.com/apppasswords (no uses tu clave normal).
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=
EMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=
ENABLE_EMAIL_SIGNALS=true
ENABLE_EMAIL_ORDERS=true
ENABLE_EMAIL_TRADES=true

# --- GENERAL & ENTORNO ---
LOG_LEVEL=INFO
ENVIRONMENT=development