# ==========================================
# CONFIGURACIÓN DEL SISTEMA DE TRADING FOREX
# ==========================================
# Copia este archivo a .env y completa tus datos. NUNCA subas el .env a git.
# No pongas comentarios al final de una línea con valor: quedan pegados al valor.

# --- FUENTE DE DATOS DE MERCADO ---
# dukascopy -> gratis, sin cuenta; corre en cualquier servidor (Linux/Docker). Solo datos.
# oanda     -> API REST con cuenta demo (no disponible en todos los países, p.ej. Ecuador).
# mt5       -> brokers MetaTrader 5 (XM, etc.). Solo Windows con el terminal abierto.
MARKET_DATA_PROVIDER=dukascopy

# --- OANDA (fuente de datos) ---
# Token: área de cliente de OANDA > "Manage API Access" (Gestionar acceso API).
# Account ID: el número de cuenta con formato 101-001-1234567-001.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
# practice = cuenta demo | live = cuenta real
OANDA_ENVIRONMENT=practice

# --- METATRADER 5 (solo si MARKET_DATA_PROVIDER=mt5) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_TIMEOUT=60000
MT5_SYMBOL_SUFFIX=
MT5_SERVER_UTC_OFFSET=auto
MT5_MAGIC=260113
SLIPPAGE=10

# --- MODO DE EJECUCIÓN ---
# DRY_RUN=true  -> paper trading: analiza precios reales y SIMULA las órdenes (sin broker).
# DRY_RUN=false -> envía órdenes al broker (hoy implementado para MT5; para otro broker se agrega su adaptador).
DRY_RUN=true
# Candado de seguridad: con una cuenta REAL el sistema se niega a operar
# salvo que esto sea true. Las cuentas demo no lo necesitan.
ALLOW_LIVE_TRADING=false
# Balance inicial de la cuenta simulada (solo DRY_RUN=true)
SIM_INITIAL_BALANCE=10000

# --- PARES DE DIVISAS Y TEMPORALIDAD ---
FOREX_PAIRS=EUR_USD,USD_JPY,GBP_USD,AUD_USD
# Granularidad de velas (M1, M5, M15, M30, H1, H4, D1)
CANDLE_GRANULARITY=M5
# Cada cuántos segundos se consulta si cerró una vela nueva
COLLECTOR_POLL_SECONDS=15
# Velas históricas a descargar al arrancar
COLLECTOR_BACKFILL_CANDLES=1000

# --- ESTRATEGIAS DEL STRATEGY-ENGINE (separadas por coma) ---
# ml             -> modelo LightGBM de config.yaml (solo su par y temporalidad, EUR_USD H1).
#                   Si no hay models/ml_<PAR>_<TF>.joblib lo entrena al arrancar (~2 min).
# ma_crossover   -> cruce de EMAs (validado: SIN VENTAJA)
# mean_reversion -> Bollinger + RSI (validado: SIN VENTAJA)
ACTIVE_STRATEGIES=ml

# --- GESTIÓN DE RIESGO ---
# Porcentaje del balance arriesgado por operación si toca el Stop Loss (1.0 = 1%)
RISK_PER_TRADE_PCT=1.0
MAX_OPEN_POSITIONS=3
# Circuit breaker: deja de abrir operaciones si la equity cae este % desde el inicio del día (UTC)
MAX_DAILY_DRAWDOWN_PCT=5.0
MAX_SPREAD_PIPS=3.0
DEFAULT_STOP_LOSS_PIPS=20.0
DEFAULT_TAKE_PROFIT_PIPS=40.0
MIN_RISK_REWARD_RATIO=1.5
ACCOUNT_SNAPSHOT_MAX_AGE_SECONDS=60
ORDER_MAX_AGE_SECONDS=120

# --- BASE DE DATOS (TimescaleDB en Docker, servicios nativos en Windows) ---
POSTGRES_USER=forex
POSTGRES_PASSWORD=forex_pw
POSTGRES_DB=forex_data
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- REDIS (Docker) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Obligatoria si Redis es accesible desde otra máquina (p.ej. tu PC vía Tailscale)
REDIS_PASSWORD=

# --- ALERTAS EN TIEMPO REAL (Telegram) ---
# Crea tu bot con @BotFather y obtén tu chat ID con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_TELEGRAM_SIGNALS=true
ENABLE_TELEGRAM_ORDERS=true
ENABLE_TELEGRAM_TRADES=true

# --- EMAIL ---
# Con Gmail: activa verificación en 2 pasos y genera una "contraseña de
# aplicación" en myaccount.google.com/apppasswords (no uses tu clave normal).
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=
EMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=
ENABLE_EMAIL_SIGNALS=true
ENABLE_EMAIL_ORDERS=true
ENABLE_EMAIL_TRADES=true

# --- AVISOS DE FALLO Y REPORTE DIARIO (email y Telegram) ---
# Aviso si algo falla más de 3 min: BD, Redis, cuenta, velas que no llegan o modelo que no evalúa.
ENABLE_SYSTEM_ALERTS=true
# Reportes de lunes a viernes con gráfico (EMAs, Fibonacci, sesiones Londres/NY y posición abierta).
ENABLE_DAILY_REPORT=true
# Horas UTC de los reportes, antes de cada sesión: 06:30 = 1:30 Ecuador (Londres), 13:00 = 8:00 Ecuador (Nueva York)
REPORT_TIMES_UTC=06:30,13:00

# --- GENERAL ---
LOG_LEVEL=INFO
ENVIRONMENT=development
