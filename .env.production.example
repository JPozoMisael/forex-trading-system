# ==========================================
# .env DE DESPLIEGUE (Dokploy) - forex-trading-system
# ==========================================
# Copia TODO este archivo en Dokploy: aplicación > Environment > pegar > Save.
# Después: Redeploy. No va a un archivo .env en el servidor.
#
# Solo hay que cambiar las 3 líneas marcadas con <CAMBIAR>. Lo opcional va
# vacío a propósito: un texto de ejemplo ("pega_aqui...") se usaría como si
# fuera real y fallaría.
#
# IMPORTANTE: nunca pongas un comentario "# ..." en la misma línea de un
# valor. Docker Compose no lo recorta y queda pegado al valor real
# (así se rompió antes REDIS_HOST y OANDA_ENVIRONMENT).

# --- PROVEEDOR DE DATOS DE MERCADO ---
# dukascopy: gratis, sin cuenta y corre en Linux/Docker (OANDA no acepta
# clientes de Ecuador y MT5 no corre en Linux). Las credenciales OANDA quedan vacías.
MARKET_DATA_PROVIDER=dukascopy
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# --- PAR Y TEMPORALIDAD (los mismos del modelo) ---
FOREX_PAIRS=EUR_USD
CANDLE_GRANULARITY=H1
COLLECTOR_POLL_SECONDS=30

# --- ESTRATEGIAS ---
# ml: el modelo LightGBM de config.yaml. Al primer arranque el strategy-engine
# lo entrena (~2 min descargando la historia de Dukascopy) y luego lo reutiliza.
ACTIVE_STRATEGIES=ml

# --- GESTIÓN DE RIESGO ---
RISK_PER_TRADE_PCT=1.0
MAX_OPEN_POSITIONS=3
MAX_DAILY_DRAWDOWN_PCT=5.0
MAX_SPREAD_PIPS=3.0
DEFAULT_STOP_LOSS_PIPS=20.0
DEFAULT_TAKE_PROFIT_PIPS=40.0
MIN_RISK_REWARD_RATIO=1.5

# --- MODO DE EJECUCIÓN (no cambiar) ---
# DRY_RUN=true: analiza y simula las órdenes; no envía nada a ningún broker.
# ALLOW_LIVE_TRADING=false: candado que impide operar una cuenta real.
DRY_RUN=true
ALLOW_LIVE_TRADING=false
SIM_INITIAL_BALANCE=10000

# --- BASE DE DATOS (servicio Postgres de Dokploy) ---
# Contraseña: la del servicio Postgres en Dokploy (pestaña General).
POSTGRES_HOST=tradingsystem-postgres-jgl1jl
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=trader
POSTGRES_PASSWORD=<CAMBIAR>

# --- REDIS (servicio Redis de Dokploy) ---
# Crear: proyecto tradingsystem > Create Service > Database > Redis > Create > Deploy.
# Copiar de la pestaña General > "Internal Credentials": Internal Host y Password.
REDIS_HOST=<CAMBIAR>
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<CAMBIAR>

# --- TELEGRAM (opcional; vacío = los avisos solo se escriben en el log) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_TELEGRAM_SIGNALS=true
ENABLE_TELEGRAM_ORDERS=true
ENABLE_TELEGRAM_TRADES=true

# --- EMAIL (opcional; vacío = los avisos solo se escriben en el log) ---
# Para activarlo: verificación en 2 pasos en Google y una "contraseña de
# aplicación" en myaccount.google.com/apppasswords (NO tu contraseña de Gmail).
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=
EMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=
ENABLE_EMAIL_SIGNALS=true
ENABLE_EMAIL_ORDERS=true
ENABLE_EMAIL_TRADES=true

# --- AVISOS DE FALLO Y REPORTE DIARIO (por email y Telegram si están configurados) ---
# Aviso si algo falla más de 3 min: BD, Redis, cuenta, velas que no llegan o modelo que no evalúa.
ENABLE_SYSTEM_ALERTS=true
# Reporte de lunes a viernes con gráfico (EMAs, Fibonacci, sesiones Londres/NY y posición abierta).
ENABLE_DAILY_REPORT=true
# Hora UTC del reporte: 12 = 7:00 en Ecuador
DAILY_REPORT_HOUR_UTC=12

# --- GENERAL ---
LOG_LEVEL=INFO
ENVIRONMENT=production
