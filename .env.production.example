# ==========================================
# .env DE DESPLIEGUE (Dokploy) - forex-trading-system
# ==========================================
# Copia estas variables al panel de entorno de Dokploy (no a un archivo .env
# en el servidor). Objetivo: correr el pipeline completo para que
# strategy-engine analice patrones sobre datos reales de OANDA (cuenta demo).
#
# IMPORTANTE: nunca pongas un comentario "# ..." en la misma línea de un
# valor. Docker Compose no lo recorta y queda pegado al valor real
# (así se rompió antes REDIS_HOST y OANDA_ENVIRONMENT).

# --- PROVEEDOR DE DATOS DE MERCADO ---
# oanda es el único proveedor que corre en este servidor Linux. mt5 es solo
# para pruebas locales en Windows, no funciona aquí.
MARKET_DATA_PROVIDER=oanda

# --- BROKER OANDA (cuenta demo/practice) ---
# Obtén el token en https://www.oanda.com/demo-account -> Manage API Access
OANDA_API_KEY=pega_aqui_tu_personal_access_token
OANDA_ACCOUNT_ID=pega_aqui_tu_account_id
OANDA_ENVIRONMENT=practice

# --- PARES DE DIVISAS Y TEMPORALIDAD ---
FOREX_PAIRS=EUR_USD,USD_JPY,GBP_USD,AUD_USD
CANDLE_GRANULARITY=M5
COLLECTOR_POLL_SECONDS=30

# --- GESTIÓN DE RIESGO ---
RISK_PER_TRADE_PCT=1.0
MAX_OPEN_POSITIONS=3
MAX_DAILY_DRAWDOWN_PCT=5.0
MAX_SPREAD_PIPS=3.0
DEFAULT_STOP_LOSS_PIPS=20.0
DEFAULT_TAKE_PROFIT_PIPS=40.0
MIN_RISK_REWARD_RATIO=1.5

# --- MODO DE EJECUCIÓN ---
# true = el strategy-engine genera y guarda señales, pero execution-engine
# NO manda ninguna orden al broker, ni siquiera a la cuenta demo. Correcto
# mientras el objetivo es solo analizar patrones, no operar todavía.
DRY_RUN=true

# --- BASE DE DATOS (usa el hostname interno real que te dio Dokploy) ---
POSTGRES_HOST=tradingsystem-postgres-jgl1jl
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=trader
POSTGRES_PASSWORD=pega_aqui_tu_password_rotada

# --- REDIS ---
# Verifica en el panel de Dokploy el hostname interno real de tu servicio de
# Redis: puede no ser literalmente "redis", igual que Postgres no fue
# "postgres" sino "tradingsystem-postgres-jgl1jl".
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- TELEGRAM (opcional, déjalo vacío si no lo usas todavía) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_TELEGRAM_SIGNALS=true
ENABLE_TELEGRAM_ORDERS=true
ENABLE_TELEGRAM_TRADES=true

# --- EMAIL (alertas de señales, órdenes y trades directo a tu correo) ---
# 1. Activa la verificación en 2 pasos en tu cuenta de Google (myaccount.google.com/security)
# 2. Genera una "contraseña de aplicación" en myaccount.google.com/apppasswords
# 3. Pégala aquí abajo (NO es tu contraseña normal de Gmail)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=tu_correo@gmail.com
EMAIL_APP_PASSWORD=pega_aqui_tu_contraseña_de_aplicacion
EMAIL_RECIPIENT=tu_correo@gmail.com
ENABLE_EMAIL_SIGNALS=true
ENABLE_EMAIL_ORDERS=true
ENABLE_EMAIL_TRADES=true

# --- GENERAL ---
LOG_LEVEL=INFO
ENVIRONMENT=production
